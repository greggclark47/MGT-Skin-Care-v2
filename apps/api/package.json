{
  "name": "@mgt/api",
  "version": "0.2.0",
  "private": true,
  "main": "dist/portal/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env dist/portal/server.js",
    "start": "node dist/portal/server.js",
    "test:portal": "node test/portal.cjs",
    "test:billing": "node test/billing.cjs",
    "test:operations": "node test/operations.cjs",
    "test:readiness": "node test/readiness.cjs",
    "test:ai-budget": "node test/ai-budget.cjs",
    "test:operators": "node test/operators.cjs",
    "worker": "node --env-file-if-exists=.env dist/portal/worker.js"
  },
  "dependencies": {
    "@mgt/domain": "workspace:*",
    "@mgt/ai-gateway": "workspace:*",
    "express": "^4.19.0",
    "stripe": "^17.4.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "typescript": "^5.5.0",
    "@types/pg": "^8.11.6"
