ARG NODE_IMAGE
FROM ${NODE_IMAGE}
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @mgt/domain build && pnpm --filter @mgt/shared build && pnpm --filter @mgt/ai-gateway build && pnpm --filter @mgt/api build
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3100 PROCESS_ROLE=api
USER node
WORKDIR /app/apps/api
EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "if(process.env.PROCESS_ROLE==='worker'){const f=process.env.WORKER_HEALTH_FILE||'/tmp/mgt-worker-health.json',i=Math.max(15,Math.min(3600,Number(process.env.WORKER_INTERVAL_SECONDS)||60)),m=Math.max(180,i*3)*1000;require('fs').stat(f,(e,s)=>process.exit(!e&&Date.now()-s.mtimeMs<m?0:1));}else{fetch('http://127.0.0.1:3100/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1));}"
CMD ["node","dist/portal/server.js"]
